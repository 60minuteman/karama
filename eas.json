{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false"
      },
      "cache": {
        "key": "yarn-production-{{ checksum('yarn.lock') }}"
      },
      "prebuildCommand": "yarn install"
    }
  },
  "submit": {
    "production": {}
  }
}
